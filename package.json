{
  "name": "cookwise",
  "version": "1.0.0",
  "private": true,
  "description": "A beginner-friendly cooking and nutrition website.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "recipes:sync": "node --env-file-if-exists=.env scripts/sync-recipes.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
